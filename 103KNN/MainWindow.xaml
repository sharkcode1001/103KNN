<Window x:Class="_103KNN.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_103KNN"
        mc:Ignorable="d"
        Title="103KNN - Plataforma Cognitiva Neuromórfica (SNN + Spike-LLM + TTFS + STDP)"
        Height="820" Width="1140"
        Background="#141622"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#252A40"/>
            <Setter Property="Foreground" Value="#F6B17A"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#3D4566"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="103KNN Cognitive Neuromorphic Platform" FontSize="25" FontWeight="Bold" Foreground="#F6B17A"/>
            <TextBlock Text="Computación Bio-Inspirada: Pensamiento Dual (S1/S2) • Generador Autorregresivo Spike-LLM (Sin KV-Cache) • k-NN por TTFS • Plasticidad STDP" 
                       FontSize="13" Foreground="#9BA4B5" Margin="0,3,0,0"/>
        </StackPanel>

        <!-- Row 1: Decision & Benchmark Buttons -->
        <Border Grid.Row="1" Background="#1D2030" CornerRadius="8" Padding="10,8" Margin="0,0,0,10">
            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="BtnFastThinking" Content="⚡ Sistema 1: Inferencia Rápida" Click="BtnFastThinking_Click" Margin="0,0,8,0"/>
                <Button x:Name="BtnDeliberativeThinking" Content="🧠 Sistema 2: Deliberación Recurrente" Click="BtnDeliberativeThinking_Click" Margin="0,0,8,0"/>
                <Button x:Name="BtnKnnBenchmark" Content="📊 Benchmark k-NN (Neuromórfico vs Euclidiano)" Click="BtnKnnBenchmark_Click" Margin="0,0,8,0"/>
                <Button x:Name="BtnStdpLearn" Content="🌱 Plasticidad STDP" Click="BtnStdpLearn_Click" Margin="0,0,8,0"/>
                <Button x:Name="BtnResetEngine" Content="🔄 Reiniciar Estado" Click="BtnResetEngine_Click"/>
            </WrapPanel>
        </Border>

        <!-- Row 2: Text Generation / Spike-LLM Input -->
        <Border Grid.Row="2" Background="#1A1E2C" CornerRadius="8" Padding="12,10" Margin="0,0,0,14" BorderBrush="#2F3650" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Prompt Semilla:" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#8BE8CB" Margin="0,0,10,0"/>
                <TextBox Grid.Column="1" x:Name="TxtPrompt" Text="el sol produce" VerticalAlignment="Center"
                         Background="#11131C" Foreground="#FFFFFF" BorderBrush="#3D4566" BorderThickness="1"
                         Padding="8,5" FontFamily="Consolas" FontSize="13" Margin="0,0,10,0"/>
                <Button Grid.Column="2" x:Name="BtnGenerateText" Content="✨ Generar Texto (Spike-LLM)" Click="BtnGenerateText_Click" Margin="0,0,8,0" Background="#343E63"/>
                <Button Grid.Column="3" x:Name="BtnTrainCorpus" Content="📚 Entrenar Corpus" Click="BtnTrainCorpus_Click"/>
            </Grid>
        </Border>

        <!-- Main Workspace -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Metrics Card -->
            <Border Grid.Column="0" Background="#1D2030" CornerRadius="8" Padding="16" Margin="0,0,14,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="MÉTRICAS DEL SISTEMA" FontWeight="Bold" FontSize="14" Foreground="#7077A1" Margin="0,0,0,12"/>

                        <TextBlock Text="Operación Activa:" Foreground="#9BA4B5" FontSize="12"/>
                        <TextBlock x:Name="TxtMode" Text="Listo para operar" FontSize="15" FontWeight="Bold" Foreground="#F6B17A" Margin="0,2,0,10"/>

                        <TextBlock Text="Decisión / Resultado Clave:" Foreground="#9BA4B5" FontSize="12"/>
                        <TextBlock x:Name="TxtWinner" Text="-" FontSize="16" FontWeight="Bold" Foreground="#4E9F3D" Margin="0,2,0,10"/>

                        <TextBlock Text="Salida Temprana (Early Exit):" Foreground="#9BA4B5" FontSize="12"/>
                        <TextBlock x:Name="TxtEarlyExit" Text="-" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,2,0,10"/>

                        <TextBlock Text="Confianza / Consenso:" Foreground="#9BA4B5" FontSize="12"/>
                        <TextBlock x:Name="TxtConfidence" Text="-" FontSize="14" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,2,0,10"/>

                        <TextBlock Text="Pasos / Tokens Producidos:" Foreground="#9BA4B5" FontSize="12"/>
                        <TextBlock x:Name="TxtSteps" Text="-" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,2,0,10"/>

                        <TextBlock Text="Cómputo Disperso (Espigas / SOPs):" Foreground="#9BA4B5" FontSize="12"/>
                        <TextBlock x:Name="TxtSpikes" Text="-" FontSize="14" FontWeight="SemiBold" Foreground="#F6B17A" Margin="0,2,0,10"/>

                        <TextBlock Text="Memoria / Eficiencia:" Foreground="#9BA4B5" FontSize="12"/>
                        <TextBlock x:Name="TxtEfficiency" Text="-" FontSize="13" FontWeight="SemiBold" Foreground="#8BE8CB" Margin="0,2,0,10"/>

                        <TextBlock Text="Latencia:" Foreground="#9BA4B5" FontSize="12"/>
                        <TextBlock x:Name="TxtLatency" Text="-" FontSize="14" FontWeight="SemiBold" Foreground="#68B984" Margin="0,2,0,4"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Console Log -->
            <Border Grid.Column="1" Background="#1D2030" CornerRadius="8" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="TELEMETRÍA NEUROMÓRFICA EN VIVO" FontWeight="Bold" FontSize="14" Foreground="#7077A1" Margin="0,0,0,8"/>
                    <TextBox Grid.Row="1" x:Name="TxtConsole" 
                             Background="#11131C" Foreground="#8BE8CB" BorderThickness="1" BorderBrush="#2D3349"
                             FontFamily="Consolas" FontSize="12"
                             IsReadOnly="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                             Padding="10"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
